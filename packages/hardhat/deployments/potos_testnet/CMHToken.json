  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"Approval\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"Transfer\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_owner\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"}],\"name\":\"allowance\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"approve\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"}],\"name\":\"balanceOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"burn\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"decimals\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"mint\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"name\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"symbol\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalSupply\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"transfer\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"transferFrom\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/CMHToken.sol\":\"CMHToken\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/CMHToken.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\ncontract CMHToken {\\n    // ---------- \\u5143\\u6570\\u636e ----------\\n    string public name = \\\"CMHToken\\\";\\n    string public symbol = \\\"CMH202430550166\\\";\\n    uint8 public decimals = 18;\\n    uint256 public totalSupply;\\n    // ---------- \\u6743\\u9650 ----------\\n    address public owner;\\n    modifier onlyOwner() {\\n        require(msg.sender == owner, \\\"CMHToken: caller is not the owner\\\");\\n        _;\\n    }\\n    // ---------- \\u72b6\\u6001 ----------\\n    // \\u8fd9\\u4e24\\u4e2a mapping \\u5c31\\u662f\\\"\\u8d26\\u672c\\\"\\u3002\\u4ee3\\u5e01\\u4e0d\\u5b58\\u5728\\u4e8e\\u4efb\\u4f55\\u94b1\\u5305\\u91cc\\uff0c\\u53ea\\u5b58\\u5728\\u4e8e\\u8fd9\\u91cc\\u3002\\n    mapping(address => uint256) private _balances;\\n    mapping(address => mapping(address => uint256)) private _allowances;\\n    // ---------- \\u4e8b\\u4ef6 ----------\\n    event Transfer(address indexed from, address indexed to, uint256 value);\\n    event Approval(\\n        address indexed owner,\\n        address indexed spender,\\n        uint256 value\\n    );\\n    constructor() {\\n        owner = msg.sender;\\n    }\\n    // ---------- \\u53ea\\u8bfb\\u67e5\\u8be2 ----------\\n    function balanceOf(address account) public view returns (uint256) {\\n        return _balances[account];\\n    }\\n    function allowance(\\n        address _owner,\\n        address spender\\n    ) public view returns (uint256) {\\n        return _allowances[_owner][spender];\\n    }\\n    // ---------- TODO 1\\uff1a\\u8f6c\\u8d26 ----------\\n    // \\u8981\\u6c42\\uff1ato \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\uff1bmsg.sender \\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\n    // \\u6263 msg.sender\\u3001\\u52a0 to\\uff1b\\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\n    function transfer(address to, uint256 value) public returns (bool) {\\n        require(to != address(0), \\\"CMHToken: transfer to zero address\\\");\\n        require(\\n            _balances[msg.sender] >= value,\\n            \\\"CMHToken: insufficient balance balance\\\"\\n        );\\n\\n        _balances[msg.sender] -= value;\\n        _balances[to] += value;\\n\\n        emit Transfer(msg.sender, to, value);\\n        return true;\\n    }\\n    // ---------- TODO 2\\uff1a\\u6388\\u6743 ----------\\n    // \\u8981\\u6c42\\uff1a\\u8bb0\\u5f55 msg.sender \\u5141\\u8bb8 spender \\u82b1 value\\uff1b\\u53d1\\u51fa Approval \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\n    function approve(address spender, uint256 value) public returns (bool) {\\n        require(spender != address(0), \\\"CMHToken: transfer to zero address\\\");\\n\\n        _allowances[msg.sender][spender] = value;\\n\\n        emit Approval(msg.sender, spender, value);\\n        return true;\\n    }\\n    // ---------- TODO 3\\uff1a\\u4ee3\\u6263\\u8f6c\\u8d26 ----------\\n    // \\u8981\\u6c42\\uff1afrom \\u7684\\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1bmsg.sender \\u5728 from \\u5904\\u7684\\u989d\\u5ea6\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\n    // \\u989d\\u5ea6\\u51cf value\\uff1b\\u6263 from\\u3001\\u52a0 to\\uff1b\\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\n    function transferFrom(\\n        address from,\\n        address to,\\n        uint256 value\\n    ) public returns (bool) {\\n        require(from != address(0), \\\"CMHToken: transfer from zero address\\\");\\n        require(to != address(0), \\\"CMHToken: transfer to zero address\\\");\\n        require(_balances[from] >= value, \\\"CMHToken: insufficient balance\\\");\\n        require(\\n            _allowances[from][msg.sender] >= value,\\n            \\\"CMHToken: insufficient allowance\\\"\\n        );\\n\\n        _allowances[from][msg.sender] -= value;\\n        _balances[from] -= value;\\n        _balances[to] += value;\\n\\n        emit Transfer(from, to, value);\\n        return true;\\n    }\\n    // ---------- TODO 4\\uff1a\\u589e\\u53d1\\uff08\\u53ea\\u6709 owner \\u80fd\\u8c03\\uff09 ----------\\n    // \\u8981\\u6c42\\uff1ato \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\uff1btotalSupply \\u52a0 value\\uff1bto \\u4f59\\u989d\\u52a0 value\\uff1b\\n    // \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff0cfrom \\u586b address(0)\\u3002\\n    function mint(address to, uint256 value) public onlyOwner {\\n        require(to != address(0), \\\"CMHToken: transfer to zero address\\\");\\n\\n        totalSupply += value;\\n        _balances[to] += value;\\n\\n        emit Transfer(address(0), to, value);\\n    }\\n    // ---------- TODO 5\\uff1a\\u9500\\u6bc1\\u81ea\\u5df1\\u7684\\u4ee3\\u5e01 ----------\\n    // \\u8981\\u6c42\\uff1amsg.sender \\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\u4f59\\u989d\\u51cf value\\uff1btotalSupply \\u51cf value\\uff1b\\n    // \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff0cto \\u586b address(0)\\u3002\\n    function burn(uint256 value) public {\\n        require(\\n            _balances[msg.sender] >= value,\\n            \\\"CMHToken: insufficient balance\\\"\\n        );\\n\\n        _balances[msg.sender] -= value;\\n        totalSupply -= value;\\n        \\n        emit Transfer(msg.sender, address(0), value);\\n    }\\n}\\n\",\"keccak256\":\"0x86f1a8e549639aaab0bbbbecbd8b26632f3f4558230a954f186e01ad9e55bb66\",\"license\":\"MIT\"}},\"version\":1}",
